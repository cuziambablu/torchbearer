# ==============================================================================
# TORCHBEARER AI — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend Configuration (Frontend & Node Runners)
# ------------------------------------------------------------------------------
# Required for client-side queries and authentication
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Required for server-side scripts / GitHub Actions (Bypasses RLS for sync/audit)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. AI Model Providers (OpenRouter & TokenRouter)
# ------------------------------------------------------------------------------
# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# TokenRouter API Key (https://tokenrouter.com)
TOKENROUTER_API_KEY=sk-...
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1

# AI Model Selection Overrides (Optional - defaults exist in code)
AI_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_FALLBACK_MODEL=z-ai/glm-5.2:free
AI_SECONDARY_MODEL=z-ai/glm-5.3-free
AI_FAST_MODEL=meta-llama/llama-3.2-3b-instruct:free

# ------------------------------------------------------------------------------
# 3. Deployment & CI/CD Credentials (GitHub Secrets)
# ------------------------------------------------------------------------------
# FTP Deployment (Legacy - configured in GitHub Secrets)
FTP_HOST=ftpupload.net
FTP_USER=your_ftp_username
FTP_PASSWORD=your_ftp_password

# Cloudflare Pages / Vercel (Recommended Target)
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...
