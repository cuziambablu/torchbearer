# =================================================================
# CampusLaunch — Production & Development Environment Configuration
# =================================================================

# 1. Supabase Database & Auth (Required for Live Multi-User State)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Autonomous Opportunity Agent & Background Scheduler
VITE_AGENT_AUTO_PUBLISH_THRESHOLD=80
VITE_AGENT_MIN_VERIFICATION_SCORE=75
VITE_AGENT_INTERVAL_HOURS=6

# 3. Serverless / Cron Worker Secret (Optional for external webhooks)
# CRON_SECRET=your-secure-cron-token-here

